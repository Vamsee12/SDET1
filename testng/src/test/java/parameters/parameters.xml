<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >

<suite name = "all parameters suite">

   <parameter name = "browser" value = "Chrome"/>
   <parameter name = "url" value = "https://www.cricbuzz.com/"/>
   
   <test name = "all parameters with chrome">
     <classes>
        <class name ="parameters.ParametersExample"/>
     </classes>
   </test>
   
   
   <parameter name = "browser" value = "Firefox"/>
   <parameter name = "url" value = "https://www.cricbuzz.com/"/>
   
   <test name = "all parameters with firefox">
     <classes>
        <class name ="parameters.ParametersExample"/>
     </classes>
   </test>
   
</suite>